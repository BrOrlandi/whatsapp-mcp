# Secrets and local configuration.
.env

# Build output. The gateway is built from source or pulled as an image; a
# committed binary is 19 MB of noise that goes stale on the next commit.
/whatsapp-mcp
# The update directory a local compose run mounts (UPDATE_DIR_HOST).
/state/
bin/
*.log

# Agent and tooling scratch directories.
.hermes/
.playwright-mcp/
.claude/*
!.claude/release.json

# Database dumps taken by update.sh before a migration. They hold message
# text, and they belong on the server they were taken on.
backups/
