# Copy to .env and replace every change-me value. Never commit .env.
EVOLUTION_API_KEY=change-me-long-random-value
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=change-me-long-random-value
EVOLUTION_AUTH_DB_NAME=evogo_auth
EVOLUTION_USERS_DB_NAME=evogo_users

RABBITMQ_USER=whatsapp
RABBITMQ_PASSWORD=change-me-long-random-value
RABBITMQ_VHOST=whatsapp
# The gateway consumes every queue Evolution creates for the subscribed events.
# Override only to narrow that set, as a comma-separated list.
# RABBITMQ_QUEUES=message,sendmessage,historysync

# Evolution's own message history, separate from the gateway's index. The
# gateway never reads it, so it is off: one copy of your conversations is
# enough, and the second one lives in a database none of this encrypts or
# prunes. Set to true only if a tool turns out to need it.
EVOLUTION_SAVE_MESSAGES=false

MINIO_ROOT_USER=whatsapp-media
MINIO_ROOT_PASSWORD=change-me-long-random-value
MINIO_BUCKET=evolution-media

MCP_DB_USER=whatsapp_mcp
MCP_DB_PASSWORD=change-me-long-random-value
MCP_DB_NAME=whatsapp_mcp

# Public address clients reach the gateway at. Not a secret: the panel prints
# it in the ready-to-paste MCP client configuration.
PUBLIC_URL=https://whatsapp-mcp.example.com

# Where the panel's port is published on the host. Loopback by default: put a
# TLS-terminating reverse proxy in front of it rather than opening this up.
PANEL_BIND=127.0.0.1
PANEL_PORT=8080

FRESHNESS_WINDOW=5m
STATUS_POLL_INTERVAL=15s
EVOLUTION_TIMEOUT=5s

# Evolution Go requires a licence and answers 503 until it has one. The panel
# handles it: with EVOLUTION_LICENSE_AUTO on (the default), it registers with
# an address on EVOLUTION_LICENSE_EMAIL_DOMAIN whose mail is read by this
# project's email worker (github.com/BrOrlandi/whatsapp-mcp-license-worker),
# which clicks the activation link — activation with no inbox and no click.
# With it off, the operator's own email gets the link and their own click
# finishes it, through the wizard. Either way the credential is kept and a
# rebuild that loses Evolution's volume is re-licensed by itself.
EVOLUTION_LICENSE_AUTO=true
EVOLUTION_LICENSE_EMAIL_DOMAIN=brorlandi.xyz
# How long the automatic path is given before the wizard stops promising and
# asks for an address the operator can open instead. Everything automatic mode
# needs sits outside this gateway — a routing rule, the worker, the licensing
# server's delivery — so the fallback matters more than the timeout's exact
# value. A working worker clicks in seconds.
EVOLUTION_LICENSE_AUTO_WAIT=3m
# Lets the panel tell you when a newer release exists, with the update command
# ready to copy. It is a public GET against GitHub every six hours and sends
# nothing about this installation; false stops it. See docs/updating.md.
UPDATE_CHECK=true

# This one is Evolution's own headless startup activation — belt and braces
# for an email already registered with them; the panel does not use it.
# EVOLUTION_OPERATOR_EMAIL=you@example.com
